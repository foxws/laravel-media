{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "foxws/laravel-media",
  "description": "Probe, encode, package and stream media in Laravel with ffmpeg, ab-av1 and Shaka Packager.",
  "keywords": [
    "laravel",
    "foxws",
    "laravel-media",
    "ffmpeg",
    "ffprobe",
    "shaka",
    "packager",
    "ab-av1",
    "hls",
    "dash",
    "streaming",
    "video"
  ],
  "homepage": "https://github.com/foxws/laravel-media",
  "license": "MIT",
  "authors": [
    {
      "name": "foxws",
      "email": "francoism90@users.noreply.github.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-openssl": "*",
    "illuminate/console": "^13.0",
    "illuminate/contracts": "^13.0",
    "illuminate/filesystem": "^13.0",
    "illuminate/process": "^13.0",
    "illuminate/support": "^13.0",
    "psr/log": "^3.0",
    "symfony/process": "^7.4 || ^8.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.9",
    "laravel/pao": "^1.0",
    "laravel/pint": "^1.29",
    "league/flysystem-aws-s3-v3": "^3.35",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "pestphp/pest-plugin-type-coverage": "^5.0.2",
    "phpstan/extension-installer": "^1.4"
  },
  "suggest": {
    "league/flysystem-aws-s3-v3": "Required for concurrent and multipart uploads to S3 disks (^3.35)."
  },
  "autoload": {
    "psr-4": {
      "Foxws\\Media\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Foxws\\Media\\Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/",
      "Workbench\\Database\\Factories\\": "workbench/database/factories/",
      "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@clear",
      "@prepare"
    ],
    "prepare": [
      "@php vendor/bin/testbench package:discover --ansi"
    ],
    "build": [
      "@php vendor/bin/testbench workbench:build --ansi"
    ],
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@build",
      "@php vendor/bin/testbench serve --ansi"
    ],
    "lint": [
      "vendor/bin/pint --parallel"
    ],
    "lint:check": [
      "vendor/bin/pint --parallel --test"
    ],
    "analyse": [
      "vendor/bin/phpstan analyse"
    ],
    "test:types": [
      "vendor/bin/pest --type-coverage --min=100"
    ],
    "test:unit": [
      "vendor/bin/pest --parallel"
    ],
    "test": [
      "@analyse",
      "@lint:check",
      "@test:types",
      "@test:unit"
    ],
    "clear": [
      "@php vendor/bin/testbench package:purge-skeleton --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Foxws\\Media\\MediaServiceProvider"
      ],
      "aliases": {
        "Media": "Foxws\\Media\\Facades\\Media"
      }
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
